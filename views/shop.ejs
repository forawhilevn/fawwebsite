<!doctype html>
<html lang="<%= locale %>">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>" data-barba="wrapper">
<%- include('partials/preloader') %>
<div data-barba="container" data-barba-namespace="shop">
<%- include('partials/header') %>

<main>
  <div class="page-shell page-shell--light">
    <%- include('partials/sub-banners', { subPage: 'shop' }) %>
    <div class="container">
      <h1 class="page-title"><%= activeCategory ? activeCategory.name : t('shop.title') %></h1>


      <% if (products.length === 0) { %>
        <p><%= t('shop.empty') %></p>
      <% } %>
    </div>
    <% if (products.length > 0) { %>
      <div class="product-grid-wrap">
        <div class="container">
          <div class="product-grid">
            <% products.forEach(function(product, idx) { %>
              <% if (idx < 6) { %>
                <%- include('partials/product-card', { product: product }) %>
              <% } else if (idx < shopLimit) { %>
                <div class="product-grid__mx"><%- include('partials/product-card', { product: product }) %></div>
              <% } else { %>
                <div class="product-grid__more" data-home-extra hidden><%- include('partials/product-card', { product: product }) %></div>
              <% } %>
            <% }); %>
          </div>
          <% if (products.length > 6) { %>
          <div class="home-more-wrap<%= products.length > shopLimit ? '' : ' home-more-wrap--mobile' %>">
            <button type="button" class="home-more" data-home-more data-step="<%= shopLimit %>"><%= t('home.loadMore') %></button>
          </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
</div>
<%- include('partials/scripts') %>
</body>
</html>
