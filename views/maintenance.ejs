<!doctype html>
<html lang="<%= locale %>">
<head>
<%- include('partials/head') %>
<meta name="robots" content="noindex" />
</head>
<body class="<%= bodyClass %>">
<% function isVid(u) { return /\.(mp4|webm|m4v|mov)(\?|$)/i.test(u || ''); } %>
<% function media(u, cls) { if (!u) return ''; return isVid(u)
     ? '<video class="maintenance__media ' + cls + '" src="' + u + '" autoplay muted loop playsinline preload="auto"></video>'
     : '<img class="maintenance__media ' + cls + '" src="' + u + '" alt="" />'; } %>
<% var hasMedia = !!(mediaDesktop || mediaMobile); %>
<% if (hasMedia) { %>
  <%- media(mediaDesktop || mediaMobile, mediaMobile && mediaMobile !== mediaDesktop ? 'is-desktop' : '') %>
  <% if (mediaMobile && mediaMobile !== mediaDesktop) { %><%- media(mediaMobile, 'is-mobile') %><% } %>
<% } %>
<main class="maintenance <%= hasMedia ? 'maintenance--media' : '' %>">
  <%# an image / video / GIF is the whole message: the text only shows when there is no media %>
  <% if (!hasMedia) { %>
    <img class="maintenance__logo" src="/images/logo/logo-mark.png" alt="FOR A WHILE" />
    <h1 class="maintenance__title"><%= closedTitle %></h1>
    <p class="maintenance__text"><%= closedMessage %></p>
    <span class="maintenance__brand">FOR A WHILE — FROM ANOTHER WORLD</span>
  <% } else { %>
    <%# with an image / video / GIF: only the brand on top and the Instagram link at the bottom %>
    <div class="maintenance__top">
      <img class="maintenance__toplogo" src="/images/logo/logo-mark.png" alt="" />
      <span class="maintenance__wordmark">FOR A WHILE</span>
    </div>
    <div class="maintenance__contact">
      <p class="maintenance__note"><%= locale === 'en' ? 'Website is being updated, contact us on Instagram:' : 'Website đang cập nhật, liên hệ qua Instagram:' %></p>
      <% ['forawhile.world', 'forawh1le.iwd'].forEach(function (h) { %>
      <a class="maintenance__ig" href="https://instagram.com/<%= h %>" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
        <%= h %>
      </a>
      <% }); %>
    </div>
  <% } %>
</main>
</body>
</html>
