<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="admin-main">
    <h1>Đổi mật khẩu</h1>

    <div class="admin-card" style="max-width:480px;">
      <% if (typeof flash !== 'undefined' && flash) { %><p class="admin-notice admin-notice--<%= flash.type %>"><%= flash.message %></p><% } %>
      <% if (notice) { %><p class="admin-notice admin-notice--success"><%= notice %></p><% } %>
      <% if (error) { %><p class="admin-error"><%= error %></p><% } %>

      <% if (step === 'form') { %>
        <p class="admin-hint">Sau khi nhập mật khẩu mới, mã OTP sẽ được gửi tới Gmail quản trị<% if (maskedEmail) { %> (<%= maskedEmail %>)<% } %> để xác nhận.</p>
        <form action="/admin/doi-mat-khau" method="post" class="admin-form">
          <label for="current">Mật khẩu hiện tại</label>
          <input type="password" id="current" name="current" required autocomplete="current-password" />
          <label for="password">Mật khẩu mới</label>
          <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" />
          <label for="confirm">Nhập lại mật khẩu mới</label>
          <input type="password" id="confirm" name="confirm" required minlength="8" autocomplete="new-password" />
          <p class="admin-hint">Tối thiểu 8 ký tự, gồm cả chữ và số.</p>
          <button type="submit" class="admin-btn" style="margin-top:8px;">Gửi mã OTP</button>
        </form>
      <% } else { %>
        <form action="/admin/doi-mat-khau/xac-nhan" method="post" class="admin-form">
          <label for="otp">Mã OTP (6 số)</label>
          <input type="text" id="otp" name="otp" class="admin-otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus autocomplete="one-time-code" />
          <button type="submit" class="admin-btn" style="margin-top:12px;">Xác nhận đổi mật khẩu</button>
        </form>
        <div style="display:flex; gap:8px; margin-top:10px;">
          <form action="/admin/doi-mat-khau/gui-lai" method="post"><button type="submit" class="admin-btn admin-btn--outline">Gửi lại mã</button></form>
          <form action="/admin/doi-mat-khau/huy" method="post"><button type="submit" class="admin-btn admin-btn--outline">Huỷ</button></form>
        </div>
      <% } %>
    </div>
  </main>
</div>
<script src="/js/password-toggle.js"></script>
</body>
</html>
