<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="admin-main">
    <h1>Đơn hàng</h1>
    <div class="admin-card">
      <table class="admin-table">
        <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>SĐT</th><th>Tổng tiền</th><th>Thanh toán</th><th>PT thanh toán</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
          <% orders.forEach(function(order) { %>
            <tr>
              <td><%= order.order_code %></td>
              <td><%= order.customer_name %></td>
              <td><%= order.phone %></td>
              <td><%= formatVND(order.total) %></td>
              <td><span class="admin-badge admin-badge--<%= order.payment_status %>"><%= order.payment_status %></span></td>
              <td><%= order.payment_method %></td>
              <td><span class="admin-badge admin-badge--<%= order.status %>"><%= order.status %></span></td>
              <td><a href="/admin/don-hang/<%= order.id %>">Chi tiết</a></td>
            </tr>
          <% }); %>
          <% if (orders.length === 0) { %>
            <tr><td colspan="8">Chưa có đơn hàng nào.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</div>
</body>
</html>
