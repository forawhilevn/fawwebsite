<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="admin-main">
    <p><a href="/admin/lifestyle">← Về danh sách Lifestyle</a></p>
    <h1>Sửa mục Lifestyle</h1>
    <% if (saved) { %><div class="admin-card"><p style="color:#166534;margin:0;">Đã lưu.</p></div><% } %>

    <form action="/admin/lifestyle/<%= set.id %>/sua" method="post" enctype="multipart/form-data" class="admin-form">
      <div class="admin-card">
        <h2 class="admin-card__title">Thông tin</h2>
        <div style="display:flex; gap:16px; flex-wrap:wrap;">
          <div style="flex:1; min-width:200px;"><label>Tiêu đề (VI)</label><input type="text" name="titleVi" value="<%= set.title_vi || '' %>" /></div>
          <div style="flex:1; min-width:200px;"><label>Tiêu đề (EN)</label><input type="text" name="titleEn" value="<%= set.title_en || '' %>" /></div>
        </div>
        <div style="display:flex; gap:16px; flex-wrap:wrap;">
          <div style="flex:1; min-width:200px;"><label>Mô tả ngắn (VI) — hiện trong pop up</label><textarea name="descVi" rows="4" maxlength="2000"><%= set.desc_vi || '' %></textarea></div>
          <div style="flex:1; min-width:200px;"><label>Mô tả ngắn (EN)</label><textarea name="descEn" rows="4" maxlength="2000"><%= set.desc_en || '' %></textarea></div>
        </div>
        <label>Credit (người chụp, người vẽ, Instagram...)</label>
        <textarea name="credit" rows="2" maxlength="500" placeholder="Ví dụ: Photo: @ten_nguoi_chup · Art: @ten_nguoi_ve"><%= set.credit || '' %></textarea>
        <p class="admin-hint">Chữ bắt đầu bằng @ sẽ tự thành link tới Instagram người đó.</p>
        <label>Sản phẩm trong bộ ảnh (hiện bên phải trong pop up trên máy tính, nút "Xem sản phẩm" trên điện thoại)</label>
        <%
          var pById = {};
          products.forEach(function (p) { pById[p.id] = p; });
          var chosen = (set.productIds || []).filter(function (id) { return pById[id]; });
        %>
        <div class="life-prods" data-life-prods>
          <div class="life-prods__list" data-prods-list>
            <% chosen.forEach(function (id) { var p = pById[id]; %>
              <div class="life-prods__item" data-pid="<%= id %>">
                <input type="hidden" name="productIds" value="<%= id %>" />
                <img src="<%= p.cover_image_url || '/images/logo/logo-mark.png' %>" alt="" />
                <span class="life-prods__name"><%= p.name_vi %></span>
                <button type="button" data-p-up title="Lên">▲</button>
                <button type="button" data-p-down title="Xuống">▼</button>
                <button type="button" data-p-del title="Bỏ">×</button>
              </div>
            <% }); %>
          </div>
          <p class="admin-hint" data-prods-empty <%= chosen.length ? 'hidden' : '' %>>Chưa chọn sản phẩm nào.</p>
          <select data-prods-add>
            <option value="">+ Thêm sản phẩm...</option>
            <% products.forEach(function (p) { %><option value="<%= p.id %>" data-name="<%= p.name_vi %>" data-img="<%= p.cover_image_url || '' %>"><%= p.name_vi %></option><% }); %>
          </select>
          <p class="admin-hint">Chọn nhiều sản phẩm; dùng ▲ ▼ để đổi thứ tự hiển thị. Nhớ bấm "Lưu".</p>
        </div>
        <label>Ảnh thumb hiện tại (ảnh ngoài trang chủ)</label>
        <img src="<%= set.thumb_url %>" alt="" style="width:120px; border-radius:6px; display:block; margin-bottom:8px;" />
        <label>Đổi ảnh thumb (không bắt buộc)</label>
        <input type="file" name="thumb" accept="image/*" data-webp />
        <label style="display:flex; align-items:center; gap:6px; font-weight:400; margin-top:12px;">
          <input type="checkbox" name="isActive" <%= set.is_active ? 'checked' : '' %> style="width:auto;" /> Hiển thị trên web
        </label>
      </div>

      <div class="admin-card">
        <h2 class="admin-card__title">Ảnh trong pop up <span><%= set.images.length %> ảnh</span></h2>
        <p class="admin-hint">Pop up chỉ hiện các ảnh dưới đây (không có ảnh thumb). Kéo ⠿ hoặc dùng ▲ ▼ để đổi thứ tự (tự lưu). Bấm Xoá để xoá ngay một ảnh.</p>
        <span class="prodorder__msg" data-sort-msg></span>
        <div class="life-admin life-admin--imgs" data-sort-list data-sort-url="/admin/lifestyle/<%= set.id %>/anh/thu-tu">
          <% set.images.forEach(function (im) { %>
            <div class="life-admin__item" data-id="<%= im.id %>" draggable="true">
              <span class="life-admin__handle"><span>⠿</span><button type="button" data-up aria-label="Lên">▲</button><button type="button" data-down aria-label="Xuống">▼</button></span>
              <img src="<%= im.image_url %>" alt="" />
              <div class="life-admin__meta"></div>
              <button type="button" class="admin-btn admin-btn--danger" data-post="/admin/lifestyle/<%= set.id %>/anh/<%= im.id %>/xoa">Xoá</button>
            </div>
          <% }); %>
          <% if (set.images.length === 0) { %><p>Chưa có ảnh nào. Pop up sẽ hiện ảnh thumb.</p><% } %>
        </div>
        <label style="margin-top:16px;">Thêm ảnh (không bắt buộc, chọn được nhiều ảnh cùng lúc)</label>
        <input type="file" name="images" accept="image/*" multiple data-webp />
      </div>

      <div class="life-savebar">
        <button type="submit" class="admin-btn">Lưu</button>
        <span>Lưu thông tin, ảnh thumb và ảnh mới (nếu có).</span>
      </div>
    </form>
  </main>
</div>
<script>
(function () {
  var box = document.querySelector('[data-life-prods]');
  if (!box) return;
  var list = box.querySelector('[data-prods-list]');
  var sel = box.querySelector('[data-prods-add]');
  var empty = box.querySelector('[data-prods-empty]');
  function sync() { empty.hidden = list.children.length > 0; }
  sel.addEventListener('change', function () {
    var opt = sel.options[sel.selectedIndex];
    if (!opt || !opt.value) return;
    if (list.querySelector('[data-pid="' + opt.value + '"]')) { sel.value = ''; return; }
    var row = document.createElement('div');
    row.className = 'life-prods__item';
    row.setAttribute('data-pid', opt.value);
    var hid = document.createElement('input'); hid.type = 'hidden'; hid.name = 'productIds'; hid.value = opt.value;
    var im = document.createElement('img'); im.alt = ''; im.src = opt.getAttribute('data-img') || '/images/logo/logo-mark.png';
    var nm = document.createElement('span'); nm.className = 'life-prods__name'; nm.textContent = opt.getAttribute('data-name');
    row.appendChild(hid); row.appendChild(im); row.appendChild(nm);
    [['data-p-up', '▲', 'Lên'], ['data-p-down', '▼', 'Xuống'], ['data-p-del', '×', 'Bỏ']].forEach(function (b) {
      var btn = document.createElement('button'); btn.type = 'button'; btn.setAttribute(b[0], ''); btn.title = b[2]; btn.textContent = b[1];
      row.appendChild(btn);
    });
    list.appendChild(row);
    sel.value = '';
    sync();
  });
  list.addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    var row = b.closest('.life-prods__item');
    if (b.hasAttribute('data-p-del')) row.remove();
    else if (b.hasAttribute('data-p-up') && row.previousElementSibling) list.insertBefore(row, row.previousElementSibling);
    else if (b.hasAttribute('data-p-down') && row.nextElementSibling) list.insertBefore(row.nextElementSibling, row);
    sync();
  });
})();
</script>
<script>
// "Xoá" buttons post their own tiny form, so the big form can stay a single one
document.addEventListener('click', function (e) {
  var b = e.target.closest && e.target.closest('[data-post]');
  if (!b) return;
  if (!confirm('Xoá ảnh này?')) return;
  var f = document.createElement('form');
  f.method = 'post'; f.action = b.getAttribute('data-post');
  document.body.appendChild(f); f.submit();
});
</script>
</body>
</html>
