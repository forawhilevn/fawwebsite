<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="admin-main">
    <h1>Banner</h1>
    <% if (error) { %><p class="admin-error"><%= error %></p><% } %>

    <div class="admin-card">
      <h2 style="margin-top:0; font-size:16px;">Hero banner (trang chủ)</h2>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
        <% heroBanners.forEach(function(b) { %>
          <div style="width:180px;">
            <img src="<%= b.image_url %>" alt="" style="width:100%; aspect-ratio: 1920/960; object-fit:cover;" />
            <div style="display:flex; gap:4px; margin-top:4px;">
              <form action="/admin/banner/chinh/<%= b.id %>/an-hien" method="post">
                <button type="submit" class="admin-btn admin-btn--outline" style="font-size:11px; padding:4px 8px;"><%= b.is_active ? 'Ẩn' : 'Hiện' %></button>
              </form>
              <form action="/admin/banner/chinh/<%= b.id %>/xoa" method="post">
                <button type="submit" class="admin-btn admin-btn--danger" style="font-size:11px; padding:4px 8px;">Xoá</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
      <form action="/admin/banner/chinh" method="post" enctype="multipart/form-data" class="admin-form">
        <label>Ảnh (khuyến nghị 1920x960)</label>
        <input type="file" name="image" accept="image/*" required />
        <label>Link liên kết (không bắt buộc)</label>
        <input type="text" name="linkUrl" placeholder="/shop" />
        <label>Tiêu đề (VI)</label>
        <input type="text" name="titleVi" />
        <label>Tiêu đề (EN)</label>
        <input type="text" name="titleEn" />
        <button type="submit" class="admin-btn" style="margin-top:12px;">Thêm hero banner</button>
      </form>
    </div>

    <div class="admin-card">
      <h2 style="margin-top:0; font-size:16px;">Banner nổi bật (featured)</h2>
      <% if (featuredBanner) { %>
        <img src="<%= featuredBanner.image_url %>" alt="" style="width:200px; margin-bottom:12px;" />
      <% } %>
      <form action="/admin/banner/noi-bat" method="post" enctype="multipart/form-data" class="admin-form">
        <label>Ảnh (khuyến nghị 900x1200)</label>
        <input type="file" name="image" accept="image/*" />
        <label>Link liên kết</label>
        <input type="text" name="linkUrl" value="<%= featuredBanner ? (featuredBanner.link_url || '') : '' %>" />
        <button type="submit" class="admin-btn" style="margin-top:12px;">Lưu</button>
      </form>
    </div>

    <div class="admin-card">
      <h2 style="margin-top:0; font-size:16px;">Archive / Lookbook</h2>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
        <% archiveBanners.forEach(function(b) { %>
          <div style="width:140px;">
            <img src="<%= b.image_url %>" alt="" style="width:100%; aspect-ratio:1/1; object-fit:cover;" />
            <form action="/admin/banner/archive/<%= b.id %>/xoa" method="post" style="margin-top:4px;">
              <button type="submit" class="admin-btn admin-btn--danger" style="font-size:11px; padding:4px 8px;">Xoá</button>
            </form>
          </div>
        <% }); %>
      </div>
      <form action="/admin/banner/archive" method="post" enctype="multipart/form-data" class="admin-form">
        <label>Ảnh</label>
        <input type="file" name="image" accept="image/*" required />
        <label>Tiêu đề (VI)</label>
        <input type="text" name="titleVi" />
        <label>Tiêu đề (EN)</label>
        <input type="text" name="titleEn" />
        <button type="submit" class="admin-btn" style="margin-top:12px;">Thêm ảnh archive</button>
      </form>
    </div>
  </main>
</div>
</body>
</html>
