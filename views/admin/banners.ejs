<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="admin-main">
    <h1>Banner</h1>
    <% if (error) { %><p class="admin-error"><%= error %></p><% } %>

    <%
      var firstActiveId = null;
      heroBanners.forEach(function (b) { if (firstActiveId === null && b.is_active) firstActiveId = b.id; });
    %>

    <div class="admin-card">
      <h2 style="margin-top:0; font-size:16px;">Trang chủ — Banner chính (hero)</h2>
      <p style="font-size:13px; color:#71717a; margin-top:-4px;">
        Vị trí: ngay đầu <a href="/" target="_blank">trang chủ</a>, trên danh sách sản phẩm.
        Trang chủ chỉ hiện <strong>ảnh đầu tiên đang bật</strong> (nhãn đỏ bên dưới). Dùng nút ↑ ↓ để đổi thứ tự.
        Mỗi banner có ảnh desktop (1920×960) và ảnh mobile (900×1100) riêng; có thể đổi từng ảnh độc lập.
      </p>
      <div class="hero-tablewrap">
      <table class="admin-table hero-table">
        <thead><tr><th>Banner</th><th>Ảnh desktop</th><th>Ảnh mobile</th><th>Thao tác</th></tr></thead>
        <tbody>
        <% heroBanners.forEach(function(b, i) {
             var hasMobile = !!b.image_mobile_url;
             var hasDesktop = !!b.image_url && b.image_url !== b.image_mobile_url;
        %>
          <tr class="<%= b.id === firstActiveId ? 'is-live' : '' %>" style="<%= b.is_active ? '' : 'opacity:.6;' %>">
            <td class="hero-table__info">
              <div class="hero-item__status">#<%= i + 1 %> · <%= b.id === firstActiveId ? 'ĐANG HIỂN THỊ' : (b.is_active ? 'Đang bật (chờ)' : 'Đang ẩn') %></div>
              <% if (b.title_vi) { %><div class="hero-item__title"><%= b.title_vi %></div><% } %>
            </td>
            <td class="hero-cell">
              <% if (hasDesktop) { %>
                <img src="<%= b.image_url %>" alt="" class="hero-cell__img hero-cell__img--d" />
              <% } else { %>
                <div class="hero-cell__empty hero-cell__empty--d">Chưa có<br />(đang dùng ảnh mobile)</div>
              <% } %>
              <form action="/admin/banner/chinh/<%= b.id %>/anh" method="post" enctype="multipart/form-data">
                <label class="btn-pick"><%= hasDesktop ? 'Đổi ảnh desktop' : 'Thêm ảnh desktop' %><input type="file" name="imageDesktop" accept="image/*" data-autosubmit hidden /></label>
              </form>
              <% if (hasDesktop && hasMobile) { %>
                <form action="/admin/banner/chinh/<%= b.id %>/anh-desktop/xoa" method="post" onsubmit="return confirm('Xoá ảnh desktop? Desktop sẽ dùng ảnh mobile.');">
                  <button type="submit" class="link-danger">Xoá ảnh desktop</button>
                </form>
              <% } %>
            </td>
            <td class="hero-cell">
              <% if (hasMobile) { %>
                <img src="<%= b.image_mobile_url %>" alt="" class="hero-cell__img hero-cell__img--m" />
              <% } else { %>
                <div class="hero-cell__empty hero-cell__empty--m">Chưa có<br />(đang dùng ảnh desktop)</div>
              <% } %>
              <form action="/admin/banner/chinh/<%= b.id %>/anh" method="post" enctype="multipart/form-data">
                <label class="btn-pick"><%= hasMobile ? 'Đổi ảnh mobile' : 'Thêm ảnh mobile' %><input type="file" name="imageMobile" accept="image/*" data-autosubmit hidden /></label>
              </form>
              <% if (hasMobile && hasDesktop) { %>
                <form action="/admin/banner/chinh/<%= b.id %>/anh-mobile/xoa" method="post" onsubmit="return confirm('Xoá ảnh mobile? Mobile sẽ dùng ảnh desktop.');">
                  <button type="submit" class="link-danger">Xoá ảnh mobile</button>
                </form>
              <% } %>
            </td>
            <td>
              <div class="hero-actions">
                <form action="/admin/banner/chinh/<%= b.id %>/len" method="post"><button type="submit" class="admin-btn admin-btn--outline" style="font-size:11px; padding:4px 8px;" <%= i === 0 ? 'disabled' : '' %>>↑</button></form>
                <form action="/admin/banner/chinh/<%= b.id %>/xuong" method="post"><button type="submit" class="admin-btn admin-btn--outline" style="font-size:11px; padding:4px 8px;" <%= i === heroBanners.length - 1 ? 'disabled' : '' %>>↓</button></form>
                <form action="/admin/banner/chinh/<%= b.id %>/an-hien" method="post"><button type="submit" class="admin-btn admin-btn--outline" style="font-size:11px; padding:4px 8px;"><%= b.is_active ? 'Ẩn' : 'Hiện' %></button></form>
                <form action="/admin/banner/chinh/<%= b.id %>/xoa" method="post" onsubmit="return confirm('Xoá cả banner này?');"><button type="submit" class="admin-btn admin-btn--danger" style="font-size:11px; padding:4px 8px;">Xoá banner</button></form>
              </div>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table>
      <% if (heroBanners.length === 0) { %><p style="font-size:13px; color:#71717a;">Chưa có banner. Trang chủ sẽ không hiện phần banner đầu trang.</p><% } %>
      </div>
      <form action="/admin/banner/chinh" method="post" enctype="multipart/form-data" class="admin-form upload-box">
        <h3 style="margin:0 0 8px; font-size:14px;">Thêm banner mới</h3>
        <p class="admin-hint">Chỉ cần tải một trong hai ảnh. Thiếu ảnh nào thì ảnh còn lại được dùng cho cả hai.</p>
        <div class="hero-new">
          <div>
            <label>🖥 Ảnh desktop (1920×960)</label>
            <input type="file" name="imageDesktop" accept="image/*" data-preview="#preview-hero-d" />
            <div class="thumbs thumbs--preview" id="preview-hero-d" hidden></div>
          </div>
          <div>
            <label>📱 Ảnh mobile (900×1100, dọc)</label>
            <input type="file" name="imageMobile" accept="image/*" data-preview="#preview-hero-m" />
            <div class="thumbs thumbs--preview" id="preview-hero-m" hidden></div>
          </div>
        </div>
        <label>Tiêu đề lớn trên ảnh (VI) — để trống sẽ dùng khẩu hiệu mặc định</label>
        <input type="text" name="titleVi" />
        <label>Tiêu đề lớn trên ảnh (EN)</label>
        <input type="text" name="titleEn" />
        <input type="hidden" name="linkUrl" value="" />
        <button type="submit" class="admin-btn" style="margin-top:12px;">Thêm banner chính</button>
      </form>
    </div>

    <div class="admin-card">
      <h2 style="margin-top:0; font-size:16px;">Trang Archive — ảnh bổ sung</h2>
      <p style="font-size:13px; color:#71717a; margin-top:-4px;">
        Vị trí: cuối <a href="/archive" target="_blank">trang Archive</a>, hiện dạng lưới 2 cột bên dưới các bộ lookbook của sản phẩm. Ảnh vuông 800×800.
      </p>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
        <% archiveBanners.forEach(function(b) { %>
          <div style="width:140px;">
            <img src="<%= b.image_url %>" alt="" style="width:100%; aspect-ratio:1/1; object-fit:cover;" />
            <% if (b.title_vi) { %><div style="font-size:12px; margin-top:4px;"><%= b.title_vi %></div><% } %>
            <form action="/admin/banner/archive/<%= b.id %>/xoa" method="post" style="margin-top:4px;" onsubmit="return confirm('Xoá ảnh này?');">
              <button type="submit" class="admin-btn admin-btn--danger" style="font-size:11px; padding:4px 8px;">Xoá</button>
            </form>
          </div>
        <% }); %>
        <% if (archiveBanners.length === 0) { %><p style="font-size:13px; color:#71717a;">Chưa có ảnh bổ sung.</p><% } %>
      </div>
      <form action="/admin/banner/archive" method="post" enctype="multipart/form-data" class="admin-form">
        <label>Ảnh</label>
        <input type="file" name="image" accept="image/*" required />
        <label>Chú thích (VI)</label>
        <input type="text" name="titleVi" />
        <label>Chú thích (EN)</label>
        <input type="text" name="titleEn" />
        <button type="submit" class="admin-btn" style="margin-top:12px;">Thêm ảnh archive</button>
      </form>
    </div>
  </main>
</div>
</body>
</html>
