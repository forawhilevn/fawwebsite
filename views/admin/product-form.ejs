<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="admin-main" data-saveall>
    <h1><%= isEdit ? 'Sửa sản phẩm' : 'Thêm sản phẩm' %></h1>

    <% if (errors.length > 0) { %>
      <div class="admin-card">
        <% errors.forEach(function(e) { %><p class="admin-error"><%= e.msg %></p><% }); %>
      </div>
    <% } %>

    <div class="admin-card">
      <form
        action="<%= isEdit ? '/admin/san-pham/' + product.id + '/sua' : '/admin/san-pham/moi' %>"
        method="post"
        enctype="multipart/form-data"
        class="admin-form"
      >
        <div style="display:flex; gap:16px;">
          <div style="flex:1;">
            <label>Tên sản phẩm (VI)</label>
            <input type="text" name="nameVi" value="<%= product.name_vi || '' %>" required />
          </div>
          <div style="flex:1;">
            <label>Tên sản phẩm (EN)</label>
            <input type="text" name="nameEn" value="<%= product.name_en || '' %>" required />
          </div>
        </div>

        <label>Danh mục</label>
        <select name="categoryId" required>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= product.category_id === cat.id ? 'selected' : '' %>><%= cat.name_vi %></option>
          <% }); %>
        </select>

        <div style="display:flex; gap:16px;">
          <div style="flex:1;">
            <label>Giá (VND)</label>
            <input type="text" inputmode="numeric" data-money autocomplete="off" name="price" value="<%= product.price || '' %>" required />
          </div>
          <div style="flex:1;">
            <label>Giá khuyến mãi (không bắt buộc)</label>
            <input type="text" inputmode="numeric" data-money autocomplete="off" name="salePrice" value="<%= product.sale_price || '' %>" />
          </div>
        </div>

        <label>SKU (không bắt buộc)</label>
        <input type="text" name="sku" value="<%= product.sku || '' %>" />

        <label>Mô tả (VI)</label>
        <textarea name="descriptionVi" rows="3"><%= product.description_vi || '' %></textarea>

        <label>Mô tả (EN)</label>
        <textarea name="descriptionEn" rows="3"><%= product.description_en || '' %></textarea>

        <label>Ảnh bìa</label>
        <input type="file" name="coverImage" accept="image/*" />
        <% if (product.cover_image_url) { %>
          <img src="<%= product.cover_image_url %>" alt="" style="width:80px; margin-top:8px;" />
        <% } %>

        <div style="margin-top: 12px; display:flex; gap:16px;">
          <label style="display:flex; align-items:center; gap:6px; font-weight:400;">
            <input type="checkbox" name="isFeatured" <%= product.is_featured ? 'checked' : '' %> style="width:auto;" /> Nổi bật
          </label>
          <label style="display:flex; align-items:center; gap:6px; font-weight:400;">
            <input type="checkbox" name="isActive" <%= product.is_active !== false ? 'checked' : '' %> style="width:auto;" /> Đang bán
          </label>
        </div>

        <button type="submit" class="admin-btn" style="margin-top: 16px;"><%= isEdit ? 'Lưu thay đổi' : 'Tạo sản phẩm' %></button>
      </form>
    </div>

    <% if (isEdit) { %>
      <%
        var vmColors = [], vmSizes = [], vmStock = {};
        variants.forEach(function (v) {
          var key = (v.color || '').toLowerCase();
          var ci = -1;
          vmColors.forEach(function (c, idx) { if (c.key === key) ci = idx; });
          if (ci < 0) { vmColors.push({ key: key, name: v.color || '', hex: v.color_hex || '#1C1C1C' }); ci = vmColors.length - 1; }
          var si = vmSizes.indexOf(v.size);
          if (si < 0) { vmSizes.push(v.size); si = vmSizes.length - 1; }
          vmStock[ci + '|' + si] = v.stock;
        });
        var vmInitial = { colors: vmColors.map(function (c) { return { name: c.name, hex: c.hex }; }), sizes: vmSizes, stock: vmStock };
      %>
      <div class="admin-card">
        <h2 class="admin-card__title">Biến thể <span>Màu sắc · Size · Tồn kho</span></h2>
        <p class="admin-hint">Một sản phẩm có thể có nhiều màu và nhiều size. Khai báo danh sách màu, danh sách size, rồi nhập tồn kho cho từng ô màu × size (để 0 nếu hết hàng).</p>
        <form action="/admin/san-pham/<%= product.id %>/bien-the/luu" method="post" class="vm" data-vm data-initial="<%= JSON.stringify(vmInitial) %>">
          <input type="hidden" name="matrix" data-vm-json value="" />

          <div class="vm__block">
            <h3 class="vm__title"><span class="vm__num">1</span> Màu sắc</h3>
            <div class="vm__colors" data-vm-colors></div>
            <button type="button" class="admin-btn admin-btn--outline" data-vm-addcolor>+ Thêm màu</button>
          </div>

          <div class="vm__block">
            <h3 class="vm__title"><span class="vm__num">2</span> Size</h3>
            <div class="vm__chips" data-vm-sizes></div>
            <div class="vm__sizeadd">
              <input type="text" data-vm-sizeinput placeholder="VD: M, XL, Free size" />
              <button type="button" class="admin-btn admin-btn--outline" data-vm-addsize>+ Thêm size</button>
              <span class="vm__quick">Thêm nhanh:
                <button type="button" data-vm-quick="S,M,L,XL">S M L XL</button>
                <button type="button" data-vm-quick="S,M,L,XL,XXL">S → XXL</button>
              </span>
            </div>
          </div>

          <div class="vm__block">
            <h3 class="vm__title"><span class="vm__num">3</span> Tồn kho</h3>
            <div class="vm__gridwrap" data-vm-grid></div>
          </div>

          <div class="variant__actions" style="border:0; padding-top:0;">
            <button type="submit" class="admin-btn">Lưu biến thể</button>
          </div>
        </form>
      </div>

      <div class="admin-card">
        <h2 class="admin-card__title">Thư viện ảnh <span><%= galleryImages.length %> ảnh</span></h2>
        <p class="admin-hint">Ảnh hiện ở trang sản phẩm theo đúng thứ tự dưới đây (ảnh đầu tiên là ảnh chính).</p>
        <div class="thumbs__grid">
          <% galleryImages.forEach(function(img, i) { %>
            <div class="thumb">
              <img src="<%= img.image_url %>" alt="" />
              <span class="thumb__badge"><%= i + 1 %></span>
              <form action="/admin/san-pham/<%= product.id %>/anh/<%= img.id %>/xoa" method="post" class="thumb__del" onsubmit="return confirm('Xoá ảnh này?');">
                <button type="submit" class="admin-btn admin-btn--danger">&times;</button>
              </form>
            </div>
          <% }); %>
          <% if (galleryImages.length === 0) { %><p class="admin-hint">Chưa có ảnh nào.</p><% } %>
        </div>
        <form action="/admin/san-pham/<%= product.id %>/anh" method="post" enctype="multipart/form-data" class="upload-box">
          <input type="file" name="images" accept="image/*" multiple data-preview="#preview-gallery" />
          <div class="thumbs thumbs--preview" id="preview-gallery" hidden></div>
          <button type="submit" class="admin-btn">Tải ảnh lên</button>
        </form>
      </div>

      <div class="admin-card">
        <% var sizeChartCur = getSizeChartUrl(product.slug); %>
        <h2 class="admin-card__title">Size chart <span><%= sizeChartCur ? 'Đã có ảnh' : 'Chưa có' %></span></h2>
        <p class="admin-hint">Ảnh bảng size hiển thị trong cửa sổ "Hướng dẫn chọn size" ở trang sản phẩm. Tải ảnh mới sẽ thay ảnh cũ (jpg, png, webp, tối đa 20MB).</p>
        <% if (sizeChartCur) { %>
          <div class="thumb" style="max-width:360px; margin-bottom:12px;">
            <img src="<%= sizeChartCur %>" alt="Size chart" style="width:100%; height:auto;" />
          </div>
          <form action="/admin/san-pham/<%= product.id %>/size-chart/xoa" method="post" onsubmit="return confirm('Xoá ảnh size chart?');" style="margin-bottom:12px;">
            <button type="submit" class="admin-btn admin-btn--danger">Xoá size chart</button>
          </form>
        <% } %>
        <form action="/admin/san-pham/<%= product.id %>/size-chart" method="post" enctype="multipart/form-data" class="upload-box">
          <input type="file" name="sizeChart" accept="image/*" required />
          <button type="submit" class="admin-btn"><%= sizeChartCur ? 'Thay ảnh size chart' : 'Tải ảnh size chart lên' %></button>
        </form>
      </div>

      <div class="admin-card">
        <h2 class="admin-card__title">Lookbook <span><%= lookbookImages.length %> ảnh</span></h2>
        <p class="admin-hint">Ảnh lookbook hiển thị ở cuối trang chi tiết sản phẩm, trang Archive và trang chủ.</p>
        <div class="thumbs__grid">
          <% lookbookImages.forEach(function(imgUrl, i) { %>
            <% const filename = imgUrl.split('/').pop(); %>
            <div class="thumb">
              <img src="<%= imgUrl %>" alt="" />
              <span class="thumb__badge"><%= i + 1 %></span>
              <form action="/admin/san-pham/<%= product.id %>/lookbook/<%= filename %>/xoa" method="post" class="thumb__del" onsubmit="return confirm('Xoá ảnh này?');">
                <button type="submit" class="admin-btn admin-btn--danger">&times;</button>
              </form>
            </div>
          <% }); %>
          <% if (lookbookImages.length === 0) { %><p class="admin-hint">Chưa có ảnh lookbook.</p><% } %>
        </div>
        <form action="/admin/san-pham/<%= product.id %>/lookbook" method="post" enctype="multipart/form-data" class="upload-box">
          <input type="file" name="lookbookImages" accept="image/*" multiple data-preview="#preview-lookbook" />
          <div class="thumbs thumbs--preview" id="preview-lookbook" hidden></div>
          <button type="submit" class="admin-btn">Tải ảnh lookbook lên</button>
        </form>
      </div>
    <% } %>
    <div class="savebar" data-savebar>
      <span class="savebar__msg" data-savebar-msg>Chưa có thay đổi</span>
      <button type="button" class="admin-btn savebar__btn" data-saveall-btn>Lưu toàn bộ trang</button>
    </div>
  </main>
</div>
</body>
</html>
