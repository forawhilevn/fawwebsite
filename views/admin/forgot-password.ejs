<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body admin-login">
  <div class="admin-login__box">
    <h1 style="font-family: var(--font-display); color: var(--color-red); font-size: 24px; margin-bottom: 4px;">FAW</h1>
    <p style="color:#71717a; font-size: 13px; margin-bottom: 16px;">Quên mật khẩu</p>
    <% if (notice) { %><p class="admin-notice admin-notice--success"><%= notice %></p><% } %>
    <% if (error) { %><p class="admin-error"><%= error %></p><% } %>

    <% if (step === 'request') { %>
      <p class="admin-hint">Nhập tên đăng nhập. Mã OTP sẽ được gửi tới Gmail quản trị<% if (maskedEmail) { %> (<%= maskedEmail %>)<% } %>.</p>
      <form action="/admin/quen-mat-khau" method="post" class="admin-form">
        <label for="username">Tên đăng nhập</label>
        <input type="text" id="username" name="username" required autofocus autocomplete="username" />
        <button type="submit" class="admin-btn" style="width:100%; margin-top: 16px; justify-content:center;">Gửi mã OTP</button>
      </form>
    <% } else { %>
      <form action="/admin/quen-mat-khau/xac-nhan" method="post" class="admin-form">
        <label for="otp">Mã OTP (6 số)</label>
        <input type="text" id="otp" name="otp" class="admin-otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus autocomplete="one-time-code" />
        <label for="password">Mật khẩu mới</label>
        <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" />
        <label for="confirm">Nhập lại mật khẩu mới</label>
        <input type="password" id="confirm" name="confirm" required minlength="8" autocomplete="new-password" />
        <p class="admin-hint">Tối thiểu 8 ký tự, gồm cả chữ và số.</p>
        <button type="submit" class="admin-btn" style="width:100%; margin-top: 8px; justify-content:center;">Đặt lại mật khẩu</button>
      </form>
      <form action="/admin/quen-mat-khau/gui-lai" method="post" style="margin-top:10px;">
        <button type="submit" class="admin-btn admin-btn--outline" style="width:100%; justify-content:center;">Gửi lại mã</button>
      </form>
      <p style="margin-top:10px; font-size:13px;"><a href="/admin/quen-mat-khau?lai=1" class="admin-link">Dùng tên đăng nhập khác</a></p>
    <% } %>
    <p style="margin-top:14px; font-size:13px;"><a href="/admin/login" class="admin-link">&larr; Quay lại đăng nhập</a></p>
  </div>
</body>
</html>
