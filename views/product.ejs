<!doctype html>
<html lang="<%= locale %>">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>" data-barba="wrapper">
<%- include('partials/preloader') %>
<div data-barba="container" data-barba-namespace="product">
<%- include('partials/header') %>

<main>
  <div class="page-shell page-shell--light">
    <div class="container">
      <% if (category) { %>
      <nav class="product-detail__breadcrumb" aria-label="Breadcrumb">
        <a href="<%= locale === 'en' ? '/en/shop' : '/shop' %>"><%= t('shop.title') %></a>
        <span>/</span>
        <a href="<%= (locale === 'en' ? '/en/shop/' : '/shop/') + category.slug %>"><%= category.name %></a>
        <span>/</span>
        <span><%= product.name %></span>
      </nav>
      <% } %>

      <div class="product-detail">
        <div class="product-detail__gallery" data-gallery>
          <div class="product-detail__main">
            <div class="product-detail__gallery-main">
              <img data-gallery-main src="<%= images[0].image_url %>" alt="<%= product.name %>" />
            </div>
          </div>
          <% if (images.length > 1) { %>
          <div class="product-detail__gallery-nav">
            <button type="button" class="product-detail__arrow-btn" data-gallery-prev aria-label="Previous image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="product-detail__dots">
              <% images.forEach(function(img, i) { %>
                <button type="button" class="product-detail__dot <%= i === 0 ? 'is-active' : '' %>" data-gallery-thumb="<%= img.image_url %>" data-index="<%= i %>" aria-label="Xem ảnh <%= i + 1 %>"></button>
              <% }); %>
            </div>
            <button type="button" class="product-detail__arrow-btn" data-gallery-next aria-label="Next image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <% } %>
        </div>

        <div class="product-detail__info">
          <h1 class="product-detail__name"><%= product.name %></h1>
          <div class="product-detail__price">
            <% if (product.sale_price) { %>
              <span class="product-card__price--sale"><%= formatVND(product.sale_price) %></span>
              <span class="product-card__price--was"><%= formatVND(product.price) %></span>
            <% } else { %>
              <%= formatVND(product.price) %>
            <% } %>
          </div>

          <%
            const defaultVariant = variants.find(function(v) { return v.stock > 0; }) || variants[0] || null;
          %>
          <form action="<%= locale === 'en' ? '/en/cart/add' : '/cart/add' %>" method="post" class="js-product-form" data-requires-variant="<%= variants.length > 1 ? '1' : '0' %>" data-variants='<%- JSON.stringify(variants) %>'>
            <input type="hidden" name="redirectTo" value="<%= locale === 'en' ? '/en/cart' : '/cart' %>" />
            <input type="hidden" name="variantId" value="<%= defaultVariant ? defaultVariant.id : '' %>" />

            <% if (sizes.length > 0) { %>
            <div class="variant-group">
              <span class="variant-group__label">
                <%= t('product.selectSize') %>
                <% if (sizeChartUrl) { %>
                  <span class="size-guide-link" data-open-size-guide><%= t('product.sizeGuide') %></span>
                <% } %>
              </span>
              <div class="variant-options" data-role="size">
                <% sizes.forEach(function(size) { %>
                  <span class="variant-option <%= defaultVariant && defaultVariant.size === size ? 'is-selected' : '' %>" data-value="<%= size %>"><%= size %></span>
                <% }); %>
              </div>
            </div>
            <% } %>

            <% if (colors.length > 0) { %>
            <div class="variant-group">
              <span class="variant-group__label"><%= t('product.selectColor') %></span>
              <div class="variant-options" data-role="color">
                <% colors.forEach(function(color) { %>
                  <span class="variant-option <%= defaultVariant && defaultVariant.color === color ? 'is-selected' : '' %>" data-value="<%= color %>"><%= color %></span>
                <% }); %>
              </div>
            </div>
            <% } %>

            <div class="variant-group">
              <span class="variant-group__label"><%= t('cart.quantity') %></span>
              <div class="qty-selector">
                <button type="button" data-qty-decrease aria-label="-">&minus;</button>
                <input type="number" name="quantity" value="1" min="1" data-qty-input />
                <button type="button" data-qty-increase aria-label="+">&plus;</button>
              </div>
            </div>

            <div class="product-detail__actions">
              <button type="submit" class="btn btn-primary js-add-to-cart">
                <%= t('product.addToCart') %>
              </button>
              <button
                type="button"
                class="btn btn-outline"
                data-wishlist-toggle
                data-wishlist-slug="<%= product.slug %>"
                data-wishlist-name="<%= product.name %>"
                data-wishlist-image="<%= images[0].image_url %>"
                data-wishlist-price="<%= formatVND(product.sale_price || product.price) %>"
                data-wishlist-href="<%= (locale === 'en' ? '/en/product/' : '/product/') + product.slug %>"
                aria-label="<%= t('product.addToWishlist') %>"
              >&hearts;</button>
            </div>
            <p class="form-error" style="display:none;" id="variantHint"><%= t('product.pleaseSelectVariant') %></p>
          </form>

          <% if (product.description) { %>
          <div class="product-detail__description"><%= product.description %></div>
          <% } %>
        </div>
      </div>

      <% if (lookbookImages.length > 0) { %>
      <div class="lookbook-strip">
        <div class="lookbook-strip__heading"><%= locale === 'en' ? 'Lookbook' : 'Lookbook' %></div>
        <div class="lookbook-strip__grid">
          <% lookbookImages.forEach(function(img) { %>
            <img src="<%= img %>" alt="<%= product.name %> lookbook" loading="lazy" data-reveal />
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (relatedProducts.length > 0) { %>
      <div style="margin-top: 64px;">
        <div class="section__heading">
          <h2 class="section__title" style="font-size: 22px;"><%= t('product.relatedProducts') %></h2>
        </div>
        <div class="product-grid product-grid--compact">
          <% relatedProducts.forEach(function(p) { %>
            <%- include('partials/product-card', { product: p }) %>
          <% }); %>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <% if (sizeChartUrl) { %>
  <div id="sizeGuideModal" class="size-guide-modal" data-close-size-guide>
    <div class="size-guide-modal__box">
      <button type="button" data-close-size-guide class="size-guide-modal__close">&times;</button>
      <img src="<%= sizeChartUrl %>" alt="<%= t('product.sizeGuide') %>" />
    </div>
  </div>
  <% } %>
</main>

<%- include('partials/footer') %>
</div>
<%- include('partials/scripts') %>
</body>
</html>
