<!doctype html>
<html lang="<%= locale %>">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>" data-barba="wrapper">
<%- include('partials/video-intro') %>
<div data-barba="container" data-barba-namespace="home">
<%- include('partials/header') %>

<main>
  <% if (heroBanners.length > 0) { %>
  <section class="hero<%= heroBanners[0].image_mobile_url ? ' hero--has-mobile' : '' %>">
    <picture>
      <% if (heroBanners[0].image_mobile_url) { %><source media="(max-width: 640px)" srcset="<%= heroBanners[0].image_mobile_url %>" /><% } %>
      <img class="hero__bg" data-parallax="12" data-reveal data-reveal-slow src="<%= heroBanners[0].image_url %>" alt="" />
    </picture>
    <% if (heroBanners[0].title) { %>
    <div class="hero__content">
      <h1 class="hero__title" data-reveal data-reveal-slow><%= heroBanners[0].title %></h1>
    </div>
    <% } %>
  </section>
  <% } %>

  <%- include('partials/sub-banners', { subPage: 'home' }) %>

  <% if (newArrivals.length > 0) { %>
  <section class="section section--alt">
    <div class="container">
      <div class="section__heading">
        <h2 class="section__title"><%= t('home.allProducts') %></h2>
      </div>
    </div>
    <div class="product-grid-wrap">
      <div class="container">
        <div class="product-grid">
          <% newArrivals.forEach(function(product, idx) { %>
            <% if (idx < homeLimit) { %>
              <%- include('partials/product-card', { product: product }) %>
            <% } else { %>
              <div class="product-grid__more" data-home-extra hidden><%- include('partials/product-card', { product: product }) %></div>
            <% } %>
          <% }); %>
        </div>
        <% if (newArrivals.length > homeLimit) { %>
        <div class="home-more-wrap">
          <button type="button" class="home-more" data-home-more data-step="<%= homeLimit %>"><%= t('home.loadMore') %></button>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (lifestyleSets.length > 0) { %>
  <section class="section">
    <div class="container">
      <div class="section__heading">
        <h2 class="section__title"><%= lifeTitle %></h2>
        <a class="life-viewall" href="<%= locale === 'en' ? '/en' : '' %>/lifestyle"><%= t('life.viewAll') %> →</a>
      </div>
      <div class="life-row-wrap">
        <button type="button" class="life-arrow life-arrow--prev" data-life-scroll="-1" aria-label="Prev">&lsaquo;</button>
        <div class="life-row" data-life-row>
          <% lifestyleSets.forEach(function(set) { %>
            <%- include('partials/lifestyle-card', { set: set }) %>
          <% }); %>
        </div>
        <button type="button" class="life-arrow life-arrow--next" data-life-scroll="1" aria-label="Next">&rsaquo;</button>
      </div>
    </div>
  </section>
  <% } %>
</main>

<%- include('partials/footer') %>
</div>
<%- include('partials/scripts') %>
</body>
</html>
