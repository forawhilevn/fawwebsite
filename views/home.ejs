<!doctype html>
<html lang="<%= locale %>">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>" data-barba="wrapper">
<%- include('partials/video-intro') %>
<div data-barba="container" data-barba-namespace="home">
<%- include('partials/header') %>

<main>
  <% if (heroBanners.length > 0) { %>
  <% var heroSlides = heroBanners.slice(0, 5); %>
  <section class="hero hero--slider<%= heroSlides[0].image_mobile_url ? ' hero--has-mobile' : '' %>" data-hero-slider data-interval="5000">
    <% heroSlides.forEach(function (b, i) { %>
    <div class="hero__slide<%= i === 0 ? ' is-active' : '' %>" data-hero-slide<%= i === 0 ? '' : ' aria-hidden="true"' %>>
      <picture>
        <% if (b.image_mobile_url) { %><source media="(max-width: 640px)" srcset="<%= b.image_mobile_url %>" /><% } %>
        <img class="hero__bg" data-parallax="12"<%= i === 0 ? ' data-reveal data-reveal-slow' : '' %> src="<%= b.image_url %>" alt="" loading="<%= i === 0 ? 'eager' : 'lazy' %>" draggable="false" />
      </picture>
      <% if (b.title) { %>
      <div class="hero__content">
        <% if (i === 0) { %><h1 class="hero__title" data-reveal data-reveal-slow><%= b.title %></h1><% } else { %><h2 class="hero__title"><%= b.title %></h2><% } %>
      </div>
      <% } %>
    </div>
    <% }); %>
    <% if (heroSlides.length > 1) { %>
    <button type="button" class="hero__arrow hero__arrow--prev" data-hero-step="-1" aria-label="Previous">&lsaquo;</button>
    <button type="button" class="hero__arrow hero__arrow--next" data-hero-step="1" aria-label="Next">&rsaquo;</button>
    <div class="hero__dots">
      <% heroSlides.forEach(function (b, i) { %><button type="button" class="hero__dot<%= i === 0 ? ' is-active' : '' %>" data-hero-dot="<%= i %>" aria-label="Banner <%= i + 1 %>"></button><% }); %>
    </div>
    <% } %>
  </section>
  <% } %>

  <%- include('partials/sub-banners', { subPage: 'home' }) %>

  <% if (newArrivals.length > 0) { %>
  <section class="section section--alt">
    <div class="container">
      <div class="section__heading">
        <h2 class="section__title"><%= t('home.allProducts') %></h2>
      </div>
    </div>
    <div class="product-grid-wrap">
      <div class="container">
        <div class="product-grid">
          <% newArrivals.forEach(function(product, idx) { %>
            <% if (idx < 6) { %>
              <%- include('partials/product-card', { product: product }) %>
            <% } else if (idx < homeLimit) { %>
              <div class="product-grid__mx"><%- include('partials/product-card', { product: product }) %></div>
            <% } else { %>
              <div class="product-grid__more" data-home-extra hidden><%- include('partials/product-card', { product: product }) %></div>
            <% } %>
          <% }); %>
        </div>
        <% if (newArrivals.length > 6) { %>
        <div class="home-more-wrap<%= newArrivals.length > homeLimit ? '' : ' home-more-wrap--mobile' %>">
          <button type="button" class="home-more" data-home-more data-step="<%= homeLimit %>"><%= t('home.loadMore') %></button>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (lifestyleSets.length > 0) { %>
  <section class="section">
    <div class="container">
      <div class="section__heading">
        <h2 class="section__title"><%= lifeTitle %></h2>
        <a class="life-viewall" href="<%= locale === 'en' ? '/en' : '' %>/lifestyle"><%= t('life.viewAll') %> →</a>
      </div>
      <div class="life-row-wrap">
        <button type="button" class="life-arrow life-arrow--prev" data-life-scroll="-1" aria-label="Prev">&lsaquo;</button>
        <div class="life-row" data-life-row>
          <% lifestyleSets.forEach(function(set) { %>
            <%- include('partials/lifestyle-card', { set: set }) %>
          <% }); %>
        </div>
        <button type="button" class="life-arrow life-arrow--next" data-life-scroll="1" aria-label="Next">&rsaquo;</button>
      </div>
    </div>
  </section>
  <% } %>
</main>

<%- include('partials/footer') %>
</div>
<%- include('partials/scripts') %>
</body>
</html>
