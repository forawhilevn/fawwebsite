<!doctype html>
<html lang="<%= locale %>">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>" data-barba="wrapper">
<%- include('partials/video-intro') %>
<div data-barba="container" data-barba-namespace="home">
<%- include('partials/header') %>

<main>
  <% if (heroBanners.length > 0) { %>
  <section class="hero">
    <picture>
      <% if (heroBanners[0].image_mobile_url) { %><source media="(max-width: 640px)" srcset="<%= heroBanners[0].image_mobile_url %>" /><% } %>
      <img class="hero__bg" data-parallax="12" data-reveal data-reveal-slow src="<%= heroBanners[0].image_url %>" alt="" />
    </picture>
    <% if (heroBanners[0].title) { %>
    <div class="hero__content">
      <h1 class="hero__title" data-reveal data-reveal-slow><%= heroBanners[0].title %></h1>
    </div>
    <% } %>
  </section>
  <% } %>

  <%- include('partials/sub-banners', { subPage: 'home' }) %>

  <% if (newArrivals.length > 0) { %>
  <section class="section section--alt">
    <div class="container">
      <div class="section__heading">
        <h2 class="section__title"><%= t('home.allProducts') %></h2>
      </div>
    </div>
    <div class="product-grid-wrap">
      <div class="container">
        <div class="product-grid">
          <% newArrivals.forEach(function(product) { %>
            <%- include('partials/product-card', { product: product }) %>
          <% }); %>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <% if (lookbookImages.length > 0) { %>
  <section class="section">
    <div class="container">
      <div class="section__heading">
        <h2 class="section__title">Lookbook</h2>
        <a href="<%= locale === 'en' ? '/en/archive' : '/archive' %>" class="section__viewall"><%= t('home.viewAll') %></a>
      </div>
    </div>
    <div class="lookbook-grid">
      <% lookbookImages.forEach(function(img) { %>
        <img src="<%= img %>" alt="" loading="lazy" />
      <% }); %>
    </div>
  </section>
  <% } %>
</main>

<%- include('partials/footer') %>
</div>
<%- include('partials/scripts') %>
</body>
</html>
