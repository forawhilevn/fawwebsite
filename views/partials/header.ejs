<header class="site-header">
  <div class="container site-header__inner">
    <nav class="site-header__nav">
      <a href="<%= locale === 'en' ? '/en/shop' : '/shop' %>"><%= t('nav.shop') %></a>
      <a href="<%= locale === 'en' ? '/en/archive' : '/archive' %>"><%= t('nav.archive') %></a>
    </nav>

    <a href="<%= locale === 'en' ? '/en' : '/' %>" class="site-header__logo" data-barba-prevent="self">
      <img src="/images/logo/logo-scribble.png" alt="FOR A WHILE" />
    </a>

    <div class="site-header__actions">
      <a href="<%= locale === 'en' ? '/en/wishlist' : '/wishlist' %>" aria-label="<%= t('nav.wishlist') %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.2C.4 8.1 2 4.5 5.6 4c2-.3 3.9.6 5 2.2C11.7 4.6 13.6 3.7 15.6 4c3.6.5 5.2 4.1 3.6 7.8C21.5 16.3 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </a>
      <a href="<%= locale === 'en' ? '/en/cart' : '/cart' %>" class="cart-badge" aria-label="<%= t('nav.cart') %>">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 4h2l2.4 12.4a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="21" r="1.4" fill="currentColor"/><circle cx="18" cy="21" r="1.4" fill="currentColor"/></svg>
        <% if (cartCount > 0) { %><span class="cart-badge__count"><%= cartCount %></span><% } %>
      </a>
      <%- include('language-switcher') %>
    </div>
  </div>
</header>
