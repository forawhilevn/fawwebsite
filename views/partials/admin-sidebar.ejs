<aside class="admin-sidebar">
  <a href="/admin" class="admin-sidebar__logo">FAW ADMIN</a>
  <nav>
    <a href="/admin" class="<%= currentPath === '/admin/' || currentPath === '/admin' ? 'is-active' : '' %>">Dashboard</a>
    <a href="/admin/san-pham" class="<%= currentPath.startsWith('/admin/san-pham') ? 'is-active' : '' %>">Sản phẩm</a>
    <a href="/admin/ton-kho" class="<%= currentPath.startsWith('/admin/ton-kho') ? 'is-active' : '' %>">Tồn kho</a>
    <a href="/admin/danh-muc" class="<%= currentPath.startsWith('/admin/danh-muc') ? 'is-active' : '' %>">Danh mục</a>
    <a href="/admin/don-hang" class="<%= currentPath.startsWith('/admin/don-hang') ? 'is-active' : '' %>">Đơn hàng</a>
    <div class="admin-navgroup">
      <span class="admin-navgroup__title">Hình banner</span>
      <a href="/admin/banner" class="<%= currentPath.startsWith('/admin/banner') && !currentPath.startsWith('/admin/banner-phu') ? 'is-active' : '' %>">Banner chính</a>
      <a href="/admin/banner-phu" class="<%= currentPath.startsWith('/admin/banner-phu') ? 'is-active' : '' %>">Banner phụ</a>
      <a href="/admin/hinh-nen" class="<%= currentPath.startsWith('/admin/hinh-nen') ? 'is-active' : '' %>">Hình nền sản phẩm</a>
    </div>
    <a href="/admin/dai-ly" class="<%= currentPath.startsWith('/admin/dai-ly') ? 'is-active' : '' %>">Cửa hàng</a>
    <a href="/admin/khuyen-mai" class="<%= currentPath.startsWith('/admin/khuyen-mai') ? 'is-active' : '' %>">Khuyến mãi</a>
    <a href="/admin/chinh-sach" class="<%= currentPath.startsWith('/admin/chinh-sach') ? 'is-active' : '' %>">Trang chính sách</a>
    <a href="/admin/ma-giam-gia" class="<%= currentPath.startsWith('/admin/ma-giam-gia') ? 'is-active' : '' %>">Mã giảm giá</a>
    <a href="/admin/cai-dat" class="<%= currentPath.startsWith('/admin/cai-dat') ? 'is-active' : '' %>">Cài đặt website<% if (typeof siteClosed !== 'undefined' && siteClosed) { %> <span style="background:#eb252a; color:#fff; font-size:10px; padding:2px 6px; border-radius:999px; margin-left:4px;">ĐÓNG</span><% } %></a>
  </nav>
  <a href="/admin/doi-mat-khau" class="admin-sidebar__account<%= currentPath.startsWith('/admin/doi-mat-khau') ? ' is-active' : '' %>">Đổi mật khẩu</a>
  <form action="/admin/logout" method="post" class="admin-sidebar__logout">
    <button type="submit" class="admin-btn admin-btn--outline" style="width:100%;">Đăng xuất</button>
  </form>
</aside>
<script src="/js/admin.js"></script>
