<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<meta name="description" content="FOR A WHILE (FAW) — streetwear brand. From another world." />
<link rel="icon" href="/images/logo/logo-mark.png" />
<link rel="apple-touch-icon" href="/images/share/apple-touch-icon.png" />
<meta name="theme-color" content="#0a0a0a" />
<% var shareUrl = (typeof siteUrl !== 'undefined' ? siteUrl : ''); %>
<meta property="og:type" content="website" />
<meta property="og:site_name" content="FOR A WHILE" />
<meta property="og:title" content="<%= title %>" />
<meta property="og:description" content="FOR A WHILE (FAW) — streetwear brand. From another world." />
<% if (typeof pageUrl !== 'undefined') { %><meta property="og:url" content="<%= pageUrl %>" /><% } %>
<meta property="og:image" content="<%= shareUrl %>/images/share/og-image.jpg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="FOR A WHILE" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="<%= shareUrl %>/images/share/og-image.jpg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
<% if (typeof gridBgCss !== 'undefined' && gridBgCss) { %><style><%- gridBgCss %></style><% } %>
