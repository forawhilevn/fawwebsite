<!doctype html>
<html lang="<%= locale %>">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>" data-barba="wrapper">
<%- include('partials/preloader') %>
<div data-barba="container" data-barba-namespace="checkout">
<%- include('partials/header') %>

<main>
  <div class="page-shell page-shell--light">
    <div class="container">
      <h1 class="page-title"><%= t('checkout.title') %></h1>

      <form action="<%= locale === 'en' ? '/en/checkout' : '/checkout' %>" method="post" class="checkout-layout">
        <div>
          <h3 style="margin-bottom: 16px;"><%= t('checkout.customerInfo') %></h3>

          <div class="form-field <%= errors.find(e => e.path === 'customerName') ? 'form-field--error' : '' %>">
            <label><%= t('checkout.fullName') %></label>
            <input type="text" name="customerName" value="<%= formData.customerName || '' %>" required />
          </div>

          <div class="form-field <%= errors.find(e => e.path === 'phone') ? 'form-field--error' : '' %>">
            <label><%= t('checkout.phone') %></label>
            <input type="tel" name="phone" value="<%= formData.phone || '' %>" required />
          </div>

          <div class="form-field">
            <label><%= t('checkout.email') %></label>
            <input type="email" name="email" value="<%= formData.email || '' %>" />
          </div>

          <div class="form-field <%= errors.find(e => e.path === 'shippingZone') ? 'form-field--error' : '' %>">
            <label><%= t('checkout.zone') %></label>
            <select name="shippingZone" data-checkout-zone required>
              <option value="" <%= !pricing.zone ? 'selected' : '' %> disabled><%= t('checkout.chooseZone') %></option>
              <option value="hcm" <%= pricing.zone === 'hcm' ? 'selected' : '' %>><%= t('checkout.zoneHcm') %></option>
              <option value="other" <%= pricing.zone === 'other' ? 'selected' : '' %>><%= t('checkout.zoneOther') %></option>
            </select>
          </div>

          <div class="form-field <%= errors.find(e => e.path === 'address') ? 'form-field--error' : '' %>">
            <label><%= t('checkout.address') %></label>
            <textarea name="address" rows="3" required><%= formData.address || '' %></textarea>
          </div>

          <div class="form-field">
            <label><%= t('checkout.note') %></label>
            <textarea name="note" rows="2"><%= formData.note || '' %></textarea>
          </div>

          <h3 style="margin: 24px 0 16px;"><%= t('checkout.paymentMethod') %></h3>
          <div class="payment-options">
            <% methods.forEach(function(m, i) { %>
              <label class="payment-option <%= (formData.paymentMethod === m.key) || (!formData.paymentMethod && i === 0) ? 'is-selected' : '' %>">
                <input type="radio" name="paymentMethod" value="<%= m.key %>" <%= (formData.paymentMethod === m.key) || (!formData.paymentMethod && i === 0) ? 'checked' : '' %> />
                <%= m.label %>
              </label>
            <% }); %>
          </div>

          <% if (errors.length > 0) { %>
            <p class="form-error" style="margin-top: 12px;">
              <% errors.forEach(function(err) { %><%= err.msg %><br/><% }); %>
            </p>
          <% } %>
        </div>

        <div>
          <div class="order-summary-box">
            <h3 style="margin-top:0;"><%= t('checkout.orderSummary') %></h3>
            <% cart.items.forEach(function(item) { %>
              <div class="order-line">
                <span><%= item.productName %> <% if (item.variantLabel) { %>(<%= item.variantLabel %>)<% } %> &times; <%= item.quantity %></span>
                <span><%= formatVND(item.lineTotal) %></span>
              </div>
            <% }); %>

            <div class="discount-row" style="display:flex; gap:8px;">
              <input type="text" name="discountCode" data-checkout-code placeholder="<%= t('checkout.discountCode') %>" value="<%= formData.discountCode || '' %>" style="flex:1; padding: 10px; border: 1px solid var(--color-fg-on-alt);" />
              <button type="button" class="btn btn-outline" data-checkout-apply style="padding: 8px 14px;"><%= t('checkout.applyDiscount') %></button>
            </div>

            <div data-checkout-totals data-quote-url="<%= locale === 'en' ? '/en/checkout/quote' : '/checkout/quote' %>">
              <%- include('partials/checkout-totals', { pricing: pricing }) %>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="margin-top: 16px;"><%= t('checkout.placeOrder') %></button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
</div>
<%- include('partials/scripts') %>
</body>
</html>
