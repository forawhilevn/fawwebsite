# Moi truong: development (SQLite, khong can cai gi them) hoac production (MySQL tren Hostinger)
NODE_ENV=development

PORT=3000

# Ngon ngu mac dinh: vi hoac en
DEFAULT_LOCALE=vi

# Session
SESSION_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-deploy

# Chi can khai bao khi NODE_ENV=production (MySQL tren Hostinger)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=faw_store

# Tai khoan admin mac dinh, chi dung khi chay seed lan dau
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ForAWhile@2026

# VietQR - hien QR chuyen khoan luc checkout (khong can tai khoan merchant)
# VIETQR_BANK_ID la ma ngan hang theo VietQR.io, vi du: MB, VCB, TCB, ACB...
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=CONG TY TNHH FOR A WHILE
VIETQR_TEMPLATE=compact2

STORE_HOTLINE=07 696969 70
